# Copiá este archivo como .env.local y completá los valores del proyecto Supabase dev.
# Para correr scripts/rls-check contra prod, otra copia como .env.prod.local con los valores
# de prod y dos usuarios descartables creados ahí (se borran al terminar). Ninguna se commitea.
# Solo variables públicas: todo lo que empieza con VITE_ termina en el bundle del frontend.
# Nunca pongas acá la service_role ni la key de Gemini.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para la prueba de aislamiento (scripts/rls-check): dos usuarios de prueba
# descartables, creados a mano en el panel de dev. Nunca credenciales de usuarios reales.
RLS_CHECK_A_EMAIL=
RLS_CHECK_A_PASSWORD=
RLS_CHECK_B_EMAIL=
RLS_CHECK_B_PASSWORD=

# Solo para las capturas de UX (scripts/ux-screens): un usuario de demo descartable de dev,
# aparte de los de rls-check. El script le carga alimentos y comidas inventados.
UX_DEMO_EMAIL=
UX_DEMO_PASSWORD=

# Solo para scripts locales (scripts/gemini-probe). Sin prefijo VITE_: nunca llega al frontend.
# En la app, esta key va únicamente en los secrets de Supabase.
GEMINI_API_KEY=
